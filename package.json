{
  "name": "mouse-move",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "pkg": "npx pkg dist/index.js --targets node18-win-x64,node18-macos-x64 --output app",
    "start": "npm run build && node dist/index.js",
    "prepare": "npm run start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Prevents system sleep by moving mouse when idle and checking connectivity",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.2",
    "kleur": "^4.1.5"
  },
  "pkg": {
    "assets": [
      "node_modules/@nut-tree-fork/nut-js/**/*"
    ],
    "targets": [
      "node22-win-x64",
      "node22-macos-x64"
    ]
  }
}
